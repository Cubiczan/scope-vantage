# Amazon Bedrock — Amazon Nova Lite via the Converse API (us-east-1).
# Anthropic Claude model IDs (anthropic.* and cross-region *.anthropic.*)
# are rejected: Claude on Bedrock is an AWS Marketplace product and is not
# covered by promo credits.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Data source API keys
UN_COMTRADE_KEY=
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
